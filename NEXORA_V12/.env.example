PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# Optional live M-Pesa Daraja STK Push
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR_PUBLIC_DOMAIN/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Optional administrator account (must match an existing user email)
ADMIN_EMAIL=

# Optional general-purpose NEXORA AI provider (server-side only; never put keys in public/app.js)
# OpenAI-compatible providers can be used by changing the base URL and model.
NEXORA_AI_API_KEY=
NEXORA_AI_BASE_URL=https://api.openai.com/v1
NEXORA_AI_MODEL=
