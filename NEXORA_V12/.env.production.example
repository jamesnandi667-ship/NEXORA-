NODE_ENV=production
PORT=3000
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
CORS_ORIGIN=https://YOUR_DOMAIN

# PostgreSQL - replace JSON persistence with a managed PostgreSQL database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexora

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR_DOMAIN/api/payments/mpesa/callback
MPESA_ENV=production

# Optional international payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional administrator account (must match an existing user email)
ADMIN_EMAIL=
